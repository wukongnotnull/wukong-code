#!/usr/bin/env bash
# SessionStart hook for wukong-code plugin
#
# Harness tool mappings live only in
# skills/using-wukong-code/references/<harness>-tools.md. This hook reads that
# file when one exists for the detected Shape A harness and wraps it with the
# skill body. Do not hand-write a second mapping table here.

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Same frontmatter contract as .opencode/plugins/wukong-code.js and
# .pi/extensions/wukong-code.ts. Tests compare the stripped bodies.
strip_yaml_frontmatter() {
  printf '%s' "$1" | awk '
    BEGIN { in_fm=0; done_fm=0 }
    NR==1 && /^---$/ { in_fm=1; next }
    in_fm && /^---$/ { in_fm=0; done_fm=1; next }
    in_fm { next }
    { print }
  ' | sed -e '1{/./!d;}'
}

harness_tools_path() {
  local plugin_root="$1"
  local harness="$2"
  printf '%s' "${plugin_root}/skills/using-wukong-code/references/${harness}-tools.md"
}

read_harness_tools() {
  local path
  path="$(harness_tools_path "$1" "$2")"
  [[ -f "$path" ]] || return 1
  cat "$path"
}

product_design_skill_path() {
  printf '%s' "$1/skills/product-design/SKILL.md"
}

product_design_composition_pointer_path() {
  printf '%s' "$1/skills/using-wukong-code/references/product-design-composition-pointer.md"
}

# Delivery-layer only. Inject when the Product Design router exists; do not
# rewrite using-wukong-code Scope routing.
read_product_design_composition_pointer() {
  local plugin_root="$1"
  local skill_path pointer_path
  skill_path="$(product_design_skill_path "$plugin_root")"
  pointer_path="$(product_design_composition_pointer_path "$plugin_root")"
  [[ -f "$skill_path" && -f "$pointer_path" ]] || return 1
  cat "$pointer_path"
}

detect_session_harness() {
  if [[ -n "${CURSOR_PLUGIN_ROOT:-}" ]]; then
    printf '%s' cursor
  elif [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]] && [[ -z "${COPILOT_CLI:-}" ]]; then
    printf '%s' claude
  elif [[ -n "${COPILOT_CLI:-}" ]]; then
    printf '%s' copilot
  else
    printf '%s' unknown
  fi
}

# Allow contract tests to source the helpers without emitting hook JSON.
if [[ "${BASH_SOURCE[0]}" != "$0" ]] && [[ "${WUKONG_SESSION_START_LIB_ONLY:-}" == "1" ]]; then
  return 0
fi

# Read using-wukong-code content and strip YAML frontmatter (align with OpenCode/Pi).
using_wukong_code_raw=$(cat "${PLUGIN_ROOT}/skills/using-wukong-code/SKILL.md" 2>&1 || echo "Error reading using-wukong-code skill")
if [[ "$using_wukong_code_raw" == Error* ]]; then
  using_wukong_code_content="$using_wukong_code_raw"
else
  using_wukong_code_content="$(strip_yaml_frontmatter "$using_wukong_code_raw")"
fi

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_wukong_code_escaped=$(escape_for_json "$using_wukong_code_content")
mapping_escaped=""
detected_harness="$(detect_session_harness)"
if mapping_raw="$(read_harness_tools "$PLUGIN_ROOT" "$detected_harness")"; then
  mapping_escaped=$(escape_for_json "$mapping_raw")
  mapping_escaped="\n\n${mapping_escaped}"
fi
pointer_escaped=""
if pointer_raw="$(read_product_design_composition_pointer "$PLUGIN_ROOT")"; then
  pointer_raw="${pointer_raw%$'\n'}"
  pointer_escaped=$(escape_for_json "$pointer_raw")
  pointer_escaped="\n\n${pointer_escaped}"
fi
session_context="<EXTREMELY_IMPORTANT>\nYou have wukong-code.\n\n**Below is the full content of your 'wukong-code:using-wukong-code' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_wukong_code_escaped}${mapping_escaped}${pointer_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
